# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PocketBase data (database files, uploads — never commit)
pb_data/

# WhatsApp service
/whatsapp-service/node_modules/
/whatsapp-service/.wwebjs_auth/
/whatsapp-service/.wwebjs_cache/

# Go build output
/instant_appoint
/instant_appoint.exe
/server
/server.exe

# Vite SPA
/web/node_modules/
/web/.vite/
# web/dist is a build artifact, but .gitkeep must stay committed:
# //go:embed all:dist is a compile error if the directory is missing, so a
# fresh clone has to be able to `go build` before Vite has ever run.
/web/dist/*
!/web/dist/.gitkeep
