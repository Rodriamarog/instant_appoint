# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node dependencies. There is no package.json at the repo root any more, so
# nothing should install here — the entry stops a stray `npm install` in the
# wrong directory from being committed.
/node_modules
/web/node_modules/
/whatsapp-service/node_modules/

# Secrets. The four environment variables live in the process environment or a
# deployment's EnvironmentFile, never in the repo.
.env*
*.pem

# Go build output. The README builds `instantappoint`; the other names are
# what `go build ./cmd/server` produces when told nothing.
/instantappoint
/instantappoint.exe
/instant_appoint
/instant_appoint.exe
/server
/server.exe

# PocketBase data (database files, uploads — never commit)
pb_data/

# Vite SPA
/web/.vite/
*.tsbuildinfo
# web/dist is a build artifact, but .gitkeep must stay committed:
# //go:embed all:dist is a compile error if the directory is missing, so a
# fresh clone has to be able to `go build` before Vite has ever run.
/web/dist/*
!/web/dist/.gitkeep

# Retired QR sidecar's browser profile; see whatsapp-service/README.md.
/whatsapp-service/.wwebjs_auth/
/whatsapp-service/.wwebjs_cache/

# debug
npm-debug.log*
.pnpm-debug.log*

# misc
.DS_Store
/coverage
